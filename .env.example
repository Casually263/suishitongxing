# Copy to .env.local and fill independent random 32-byte base64 keys.
# scripts/start-local-dependencies.ps1 generates a private local file automatically.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://127.0.0.1:3306/suishi_dev?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC
DB_USERNAME=suishi
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET_BASE64=
EMAIL_ENCRYPTION_KEY_BASE64=
EMAIL_HMAC_KEY_BASE64=
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_BOOTSTRAP_ENABLED=true
ADMIN_USERNAME=demo_admin
ADMIN_PASSWORD=
APP_DEMO_ENABLED=true
DEMO_PASSWORD=
COMPOSE_MYSQL_ROOT_PASSWORD=
# Optional AI: credentials stay on the backend. No key means explicit local script fallback.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_ALLOWED_ORIGINS=https://api.openai.com
# Only honored in dev/test; keep false for public providers and production.
AI_ALLOW_LOCAL_ENDPOINTS=false
